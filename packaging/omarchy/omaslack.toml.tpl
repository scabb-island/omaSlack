# omaslack TUI theme, rendered by Omarchy from omaslack.toml.tpl on every
# theme change. One key per TUI color role, as hex colors. Edits here are
# lost on the next theme change: change the template instead.
# The role mapping matches internal/tui/theme/roles.go.

background = "{{ background }}"
foreground = "{{ foreground }}"
muted      = "{{ muted }}"
accent     = "{{ accent }}"
border     = "{{ lighter_background }}"
selection  = "{{ selection }}"
unread     = "{{ yellow }}"
mention    = "{{ red }}"
code       = "{{ green }}"
quote      = "{{ magenta }}"
success    = "{{ green }}"
warning    = "{{ yellow }}"
error      = "{{ red }}"
